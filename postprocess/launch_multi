#!/bin/bash
# Authors: Seth McGinnis, Jacob Stuivenvolt-Allen
#
# launch_multi - Automates submission of MPMD commandfiles
#
# For each commandfile, launch_multi creates a separate run directory
# to corral output files, copies any necessary scripts or config
# files, then submits the job via launch_cf.
#
# Usage: launch_multi [options] --run DIR cmdfile1 [cmdfile2 ...] [--final cmdfile]
#
# Options:
#   --run DIR           Directory where run subdirectories are created (required)
#   --workflow NAME     Apply a predefined workflow configuration (see below)
#   --scripts PATH      Directory containing workflow scripts to copy
#                         (default: directory containing launch_multi)
#   --config FILE       Environment config file (default: ~/config_env.sh)
#   --copy FILE         Additional file/dir to copy into each run directory;
#                       directories are copied recursively (can be repeated)
#   --chain             Submit jobs as a dependency chain
#                         (each waits for the previous via afterok)
#   --final FILE        Submit FILE as a final job dependent on all others
#                         via afterok (mutually exclusive with --chain)
#   --skip-missing      Ignore any missing or empty commandfiles
#                         (Useful for chains with some steps already done)
#   --dry               Print commands without executing
#   --sleep N           Delay in seconds between job submissions (default: 1)
#   --max-queued N      Before each submission, wait until (your queued jobs
#                         + steps in the commandfile) <= N.  Array subjobs
#                         count individually, as they do for Casper's
#                         per-user limit.  0 disables.  (default: 4500, or
#                         $LAUNCH_MULTI_MAX_QUEUED if set)
#   --poll N            Seconds between queue checks while waiting (default: 120)
#   --wall TIME        Wallclock time limit (default: 00:20:00)
#   --mem MEM           Memory (e.g. 25GB) (default: none; --mem is not passed)
#   -A ACCOUNT          PBS account (default: $PROJECT)
#   -N NAME             Job name or prefix (default: basename of cmdfile)
#   -j JOIN             Join stdout/stderr (default: oe)
#   -m MAIL             Mail options (default: a)
#   -q QUEUE            PBS queue (default: casper)
#   --help              Show this help
#
# Workflows (--workflow NAME):
#   cordex    Sets --wall 1:00:00, --mem 50GB,
#             --config $SCRIPTS_DIR/config_env.sh, and copies scripts
#             needed by the workflow from SCRIPTS_DIR.
#             All of these can be overridden by flags that follow --workflow.
#
# Any other option is passed through to launch_cf (and then to qsub).  An
# unrecognized option followed by a non-dash argument takes that argument as
# its value, so a valueless passthrough flag placed directly before a
# commandfile will swallow it; put such flags last or before another option.

set -e

# Defaults
account="${PROJECT:-}"
chain=0
finalfile=""
cmdfiles=()
config="$HOME/config_env.sh"
config_specified=0
copyfiles=()
dry=0
jobprefix=""
join="oe"
mail="a"
max_queued="${LAUNCH_MULTI_MAX_QUEUED:-4500}"
mem=""
passthrough=()
poll=120
queue="casper"
runpath=""
scripts_dir="$(dirname "$(realpath "$0")")"
skipmissing=0
sleep=1
walltime="00:20:00"

usage() {
    sed -n '3,/^$/p' "$0" | sed 's/^# \?//'
    exit "${1:-0}"
}

die() {
    echo "Error: $1" >&2
    exit 1
}

warn() {
    echo "Warning: $1" >&2
}

run_cmd() {
    if [[ $dry -eq 1 ]]; then
        echo "  $1"
    else
        eval "$1"
    fi
}

# Apply a named workflow configuration.
# Flags that appear after --workflow on the command line will override these.
apply_workflow() {
    local name="$1"
    case "$name" in
        cordex)
            walltime="1:00:00"
            mem="50GB"
            config="$scripts_dir/config_env.sh"
            config_specified=1
            copyfiles+=(
                "$scripts_dir/postproc_fx.py"
                "$scripts_dir/postproc_engine.py"
                "$scripts_dir/postproc_vars.py"
		"$scripts_dir/postproc_wbgt.py"
                "$scripts_dir/cmorize.sh"
                "$scripts_dir/plot.postprocess.var.py"
            )
	    # Note: tasks are generally < 20 min, but many-many
	    # I/O-bound tasks running in parallel can be slower than a
	    # single task because of bandwidth to disk.  Similarly,
	    # tasks are generally << 50 GB, but transient memory
	    # spikes exist, and can generate error messages even if
	    # they don't cause failure, which makes checking success
	    # harder.
            ;;
        *)
            die "Unknown workflow: $name"
            ;;
    esac
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --help)
            usage 0
            ;;
        --run)
            runpath="$2"
            shift 2
            ;;
        --workflow)
            apply_workflow "$2"
            shift 2
            ;;
        --scripts)
            scripts_dir="$(realpath "$2")"
            shift 2
            ;;
        --wall)
            walltime="$2"
            shift 2
            ;;
        --mem)
            mem="$2"
            shift 2
            ;;
        --config)
            config="$2"
            config_specified=1
            shift 2
            ;;
        --copy)
            copyfiles+=("$2")
            shift 2
            ;;
        --chain)
            chain=1
            shift
            ;;
        --final)
            finalfile="$2"
            shift 2
            ;;
        --sleep)
            sleep="$2"
            shift 2
            ;;
        --max-queued)
            max_queued="$2"
            shift 2
            ;;
        --poll)
            poll="$2"
            shift 2
            ;;
        -N)
            jobprefix="$2"
            shift 2
            ;;
        -A)
            account="$2"
            shift 2
            ;;
        -q)
            queue="$2"
            shift 2
            ;;
        -m)
            mail="$2"
            shift 2
            ;;
        -j)
            join="$2"
            shift 2
            ;;
        --skip-missing)
            skipmissing=1
            shift
            ;;
        --dry)
            dry=1
            shift
            ;;
        -*)
            # Unknown option: pass through to launch_cf
            passthrough+=("$1")
            if [[ $# -gt 1 && ! "$2" =~ ^- ]]; then
                passthrough+=("$2")
                shift
            fi
            shift
            ;;
        *)
            # Positional argument: commandfile
            cmdfiles+=("$1")
            shift
            ;;
    esac
done

# With --skip-missing, drop missing or empty commandfiles up front, so
# that later validation and the dependency chain only see what will run.
# prev_jobid is only set by submitted jobs, so chains stay correct.
if [[ $skipmissing -eq 1 ]]; then
    nreq=${#cmdfiles[@]}
    kept=()
    for cf in "${cmdfiles[@]}"; do
        if [[ -s "$cf" ]]; then
            kept+=("$cf")
        else
            echo "Skipping missing/empty commandfile: $cf" >&2
        fi
    done
    cmdfiles=("${kept[@]}")

    if [[ -n "$finalfile" && ! -s "$finalfile" ]]; then
        echo "Skipping missing/empty final commandfile: $finalfile" >&2
        finalfile=""
    fi

    # Nothing left to run is not an error; the final job is moot too
    if [[ $nreq -gt 0 && ${#cmdfiles[@]} -eq 0 ]]; then
        echo "No commandfiles left to submit." >&2
        exit 0
    fi
fi

# Validate required arguments
[[ -z "$runpath" ]] && die "--run is required"
[[ ${#cmdfiles[@]} -eq 0 ]] && die "No commandfiles specified"
[[ -z "$account" ]] && die "No account specified (-A) and \$PROJECT not set"

[[ $chain -eq 1 && -n "$finalfile" ]] && die "--chain and --final are mutually exclusive"
[[ -n "$finalfile" && ! -f "$finalfile" ]] && die "Final commandfile not found: $finalfile"
for cf in "${cmdfiles[@]}"; do
    [[ -f "$cf" ]] || die "Commandfile not found: $cf"
done

[[ "$max_queued" =~ ^[0-9]+$ ]] || die "--max-queued must be a non-negative integer"
[[ "$poll" =~ ^[0-9]+$ && $poll -gt 0 ]] || die "--poll must be a positive integer"

# Number of steps (non-blank, non-comment lines) in a commandfile; each
# becomes one PBS array subjob.
count_steps() {
    grep -cvE '^[[:space:]]*(#|$)' "$1" || true
}

# A commandfile larger than the queue limit can never be submitted;
# catch that before submitting anything.
if [[ $max_queued -gt 0 ]]; then
    for cf in "${cmdfiles[@]}" ${finalfile:+"$finalfile"}; do
        n=$(count_steps "$cf")
        [[ $n -le $max_queued ]] || die "$cf has $n steps, more than --max-queued ($max_queued).
Split it first, e.g.: split -l 2000 --additional-suffix=.cmd $cf ${cf%.cmd}_part_"
    done
fi

# Count this user's queued + running jobs, counting array subjobs
# individually and skipping array parents ("123[]") and finished
# subjobs (state X/F).  Returns nonzero if qstat fails.
queued_jobs() {
    local out
    out=$(qstat -t -u "$USER" 2>/dev/null) || return 1
    awk '$1 ~ /^[0-9]/ && $1 !~ /\[\]/ && $10 !~ /^[XF]$/ {n++} END {print n+0}' <<< "$out"
}

# Block until there is room in the queue for $1 more jobs.
wait_for_room() {
    local need="$1" n
    [[ $max_queued -le 0 || $dry -eq 1 ]] && return 0
    while :; do
        if n=$(queued_jobs); then
            (( n + need <= max_queued )) && return 0
            echo "  Waiting: $n queued + $need new > $max_queued; rechecking in ${poll}s ($(date +%H:%M))"
        else
            echo "  Waiting: qstat failed; rechecking in ${poll}s ($(date +%H:%M))"
        fi
        sleep "$poll"
    done
}

# Check config file
if [[ ! -f "$config" ]]; then
    if [[ $config_specified -eq 1 ]]; then
        die "Config file not found: $config"
    else
        warn "Default config ~/config_env.sh not found; using 'module restore default'."
        warn "Create ~/config_env.sh to customize the run environment."
        config=""
    fi
fi

# Check additional files to copy
for f in "${copyfiles[@]}"; do
    [[ -e "$f" ]] || die "File to copy not found: $f"
done

# Create base runpath if needed
run_cmd "mkdir -p $(printf %q "$runpath")"

here="$(pwd)"

# Submit a single job.  Sets last_jobid to the submitted job ID (or a
# placeholder under --dry).  Arguments:
#   $1  cmdfile (path)
#   $2  label suffix for the === header (e.g. "" or " (final)")
#   $3  dependency string passed to -W depend= (e.g. "afterok:123:456"), or ""
submit_job() {
    local cmdfile="$1" label="$2" dep="$3"
    local cmdfile_abs cmd basename_no_ext jobname rundir launch_cmd

    cmdfile_abs="$(cd "$(dirname "$cmdfile")" && pwd)/$(basename "$cmdfile")"
    cmd="$(basename "$cmdfile")"
    basename_no_ext="${cmd%.cmd}"
    if [[ -n "$jobprefix" ]]; then
        jobname="${jobprefix}_${basename_no_ext}"
    else
        jobname="$basename_no_ext"
    fi

    ## if $id is set, prepend an abbreviated version for pbs jobname
    if [[ "${id:-}" =~ ^([[:alnum:]]+)-([[:alnum:]]+)$ ]]; then
        pbsname="${BASH_REMATCH[1]:0:1}${BASH_REMATCH[2]:0:1}.${jobname}"
    else
        pbsname="$jobname"
    fi
    
    rundir="$runpath/$jobname"
    echo "=== ${jobname}${label} ==="

    wait_for_room "$(count_steps "$cmdfile_abs")"

    run_cmd "rm -rf $(printf %q "$rundir")"
    run_cmd "mkdir -p $(printf %q "$rundir")"
    run_cmd "cp $(printf %q "$cmdfile_abs") $(printf %q "$rundir/")"

    if [[ -n "$config" ]]; then
        run_cmd "cp $(printf %q "$config") $(printf %q "$rundir/config_env.sh")"
    else
        run_cmd "echo 'module restore default' > $(printf %q "$rundir/config_env.sh")"
    fi

    for f in "${copyfiles[@]}"; do
        run_cmd "cp -r $(printf %q "$f") $(printf %q "$rundir/")"
    done

    run_cmd "cd $(printf %q "$rundir")"

    launch_cmd="launch_cf -A $(printf %q "$account") -q $(printf %q "$queue")"
    launch_cmd+=" -m $(printf %q "$mail") -j $(printf %q "$join")"
    launch_cmd+=" -N $(printf %q "$pbsname") -l walltime=$(printf %q "$walltime")"
    if [[ -n "$mem" ]]; then
        launch_cmd+=" --mem $(printf %q "$mem")"
    fi
    if [[ -n "$dep" ]]; then
        launch_cmd+=" -W depend=$dep"
    fi
    for arg in "${passthrough[@]}"; do
        launch_cmd+=" $(printf %q "$arg")"
    done
    launch_cmd+=" $(printf %q "$cmd")"

    if [[ $dry -eq 1 ]]; then
        echo "  $launch_cmd"
        last_jobid="DRY_JOBID_${jobname}"
    else
        local out rc=0
        out=$(eval "$launch_cmd") || rc=$?
        echo "$out" >&2
        last_jobid=$(tail -1 <<< "$out")
        if [[ $rc -ne 0 || ! "$last_jobid" =~ ^[0-9]+(\[\])?\.[[:alnum:]._-]+$ ]]; then
            die "Submission failed for $cmd (no job ID returned).
This and any later commandfiles were NOT submitted.  Already submitted: ${all_jobids[*]:-none}"
        fi
        echo "  Submitted: $last_jobid"
    fi

    run_cmd "cd $(printf %q "$here")"
}

last_jobid=""
prev_jobid=""
all_jobids=()

for cmdfile in "${cmdfiles[@]}"; do
    dep=""
    if [[ $chain -eq 1 && -n "$prev_jobid" ]]; then
        dep="afterok:$prev_jobid"
    fi

    submit_job "$cmdfile" "" "$dep"
    prev_jobid="$last_jobid"
    all_jobids+=("$last_jobid")

    run_cmd "sleep $sleep"
done

# Submit final job dependent on all preceding jobs
if [[ -n "$finalfile" ]]; then
    dep_list="$(IFS=:; echo "${all_jobids[*]}")"
    submit_job "$finalfile" " (final)" "afterok:$dep_list"
fi
